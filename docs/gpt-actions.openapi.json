{
  "openapi": "3.1.0",
  "info": {
    "title": "LaunchLayer jobs",
    "version": "1.0.0",
    "description": "Record workshop jobs for LaunchLayer. The GPT sees customer name and device only. It must never send or receive a phone number, never see a photo file, and never message a customer. Confirm with Jordan before create_job, set_status, and create_collection_event."
  },
  "servers": [
    {
      "url": "https://YOUR-VERCEL-DEPLOYMENT.vercel.app",
      "description": "Replace with the deployed origin, or import /openapi.json from that deployment so the server URL is filled in."
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/actions/jobs": {
      "post": {
        "operationId": "create_job",
        "summary": "Record a new job",
        "description": "Use only after Jordan has confirmed a new job should be recorded. Send customer name, device, the reported fault, and a one-line next_move. Do not send a phone number or a password. If you send price_gbp without price_basis, it is stored as an estimate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateJobRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The job that was recorded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "operationId": "find_jobs",
        "summary": "Find jobs",
        "description": "Use to decide which job Jordan means, or to list work in progress. Filter by customer_name, device, ref, or status. If status is omitted, only active jobs are returned (everything except collected and closed_no_repair). Read each summary_line before choosing a job. The phone number is never returned.",
        "parameters": [
          {
            "name": "customer_name",
            "in": "query",
            "required": false,
            "description": "Case-insensitive part of the customer name.",
            "schema": { "type": "string" }
          },
          {
            "name": "device",
            "in": "query",
            "required": false,
            "description": "Case-insensitive part of the device label.",
            "schema": { "type": "string" }
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "description": "Exact job ref, such as LL-4K7M.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "A status value, or active. Omit for active jobs.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching jobs, newest activity first.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FindJobsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/actions/jobs/{ref}": {
      "get": {
        "operationId": "get_job",
        "summary": "Read one job",
        "description": "Use before talking about a job you already identified. Notes are newest first. Photos are not returned: only photo_count and photo_captions. The phone number is never returned.",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "Job ref, such as LL-4K7M.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The job, its notes, and photo captions.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetJobResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/actions/notes": {
      "post": {
        "operationId": "add_note",
        "summary": "File a note",
        "description": "Use to file what Jordan just said about an existing job. text is his words, lightly tidied. summary is about 100 characters. tag may be omitted. This does not change status and does not create a calendar entry. You may also send next_move when the next step changed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddNoteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The job identity and the note that was filed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NoteResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/actions/notes/edit": {
      "post": {
        "operationId": "edit_note",
        "summary": "Correct a note",
        "description": "Use when Jordan corrects a note that was already filed. Send the job ref and the note id. The previous wording is kept. Confirm the ref before you call this.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EditNoteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The job identity and the note after the edit.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NoteResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/actions/jobs/status": {
      "post": {
        "operationId": "set_status",
        "summary": "Set status or price",
        "description": "Use only after Jordan has confirmed a status change. Also use this to record a price or that a fixed price was agreed: price_basis quote is only for an agreed fixed price, and the server sets price_agreed_at when you do not send one. Sending the current status is allowed when you only need to update price, next_move, access_given, backup_position, or follow_up_at.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SetStatusRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The job after the update.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/actions/jobs/collection": {
      "post": {
        "operationId": "create_collection_event",
        "summary": "Record collection on the calendar",
        "description": "Use only after Jordan has confirmed a collection time. Creates a private Google Calendar entry, or updates the existing entry for this job if collection_at changes. Never add the customer as a guest. Send an ISO datetime with a timezone offset.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CollectionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The job identity and the calendar result.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CollectionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The LaunchLayer action API key."
      }
    },
    "responses": {
      "Error": {
        "description": "The action was rejected. When a job was identified, ref, customer_name, and device_label are included.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "CreateJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_request_id", "customer_name", "device_label", "reported_fault", "next_move"],
        "properties": {
          "client_request_id": { "type": "string", "description": "Unique for this write. Reuse it only to retry the identical call." },
          "customer_name": { "type": "string" },
          "device_label": { "type": "string" },
          "reported_fault": { "type": "string" },
          "next_move": { "type": "string", "description": "One line: what happens next." },
          "price_gbp": { "type": ["number", "null"] },
          "price_basis": { "type": "string", "enum": ["estimate", "quote"], "description": "Defaults to estimate when a price is sent. quote only when a fixed price is agreed." },
          "price_agreed_at": { "type": ["string", "null"], "description": "ISO datetime with a timezone offset. Set by the server when basis is quote and this is omitted." },
          "backup_position": {
            "type": ["string", "null"],
            "enum": ["customer_backed_up", "we_backed_up", "not_needed", "not_discussed", null]
          },
          "access_given": { "type": ["boolean", "null"], "description": "Yes or no. Never send a password." },
          "follow_up_at": { "type": ["string", "null"] }
        }
      },
      "AddNoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_request_id", "ref", "text", "summary"],
        "properties": {
          "client_request_id": { "type": "string" },
          "ref": { "type": "string" },
          "text": { "type": "string", "description": "Jordan's words, lightly tidied." },
          "summary": { "type": "string", "description": "About 100 characters." },
          "tag": {
            "type": ["string", "null"],
            "enum": ["finding", "work_done", "parts", "customer_contact", "quote_auth", "other", null],
            "description": "Optional. Untagged is valid. Send null to leave it untagged."
          },
          "amount_gbp": { "type": ["number", "null"], "description": "Optional part or cost mentioned in the note. This does not set the job price." },
          "part_detail": { "type": ["string", "null"] },
          "next_move": { "type": "string", "description": "Optional. Replaces the job's one-line next step." }
        }
      },
      "EditNoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_request_id", "ref", "note_id"],
        "properties": {
          "client_request_id": { "type": "string" },
          "ref": { "type": "string" },
          "note_id": { "type": "string" },
          "text": { "type": "string" },
          "summary": { "type": "string" },
          "tag": {
            "type": ["string", "null"],
            "enum": ["finding", "work_done", "parts", "customer_contact", "quote_auth", "other", null]
          },
          "amount_gbp": { "type": ["number", "null"] },
          "part_detail": { "type": ["string", "null"] }
        }
      },
      "SetStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_request_id", "ref", "status"],
        "properties": {
          "client_request_id": { "type": "string" },
          "ref": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["new", "diagnosing", "waiting_on_parts", "waiting_on_customer", "ready", "collected", "closed_no_repair"]
          },
          "next_move": { "type": "string" },
          "price_gbp": { "type": ["number", "null"] },
          "price_basis": { "type": "string", "enum": ["estimate", "quote"] },
          "price_agreed_at": { "type": ["string", "null"] },
          "backup_position": {
            "type": ["string", "null"],
            "enum": ["customer_backed_up", "we_backed_up", "not_needed", "not_discussed", null]
          },
          "access_given": { "type": ["boolean", "null"] },
          "follow_up_at": { "type": ["string", "null"] }
        }
      },
      "CollectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_request_id", "ref", "collection_at"],
        "properties": {
          "client_request_id": { "type": "string" },
          "ref": { "type": "string" },
          "collection_at": { "type": "string", "description": "ISO datetime with a timezone offset, such as 2026-10-02T16:00:00+01:00." }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "customer_name", "device_label", "reported_fault", "status", "next_move"],
        "properties": {
          "ref": { "type": "string" },
          "customer_name": { "type": "string" },
          "device_label": { "type": "string" },
          "reported_fault": { "type": "string" },
          "status": { "type": "string" },
          "next_move": { "type": "string" },
          "price_gbp": { "type": ["number", "null"] },
          "price_basis": { "type": ["string", "null"] },
          "price_agreed_at": { "type": ["string", "null"] },
          "backup_position": { "type": ["string", "null"] },
          "access_given": { "type": ["boolean", "null"] },
          "collection_at": { "type": ["string", "null"] },
          "calendar_event_id": { "type": ["string", "null"] },
          "follow_up_at": { "type": ["string", "null"] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "closed_at": { "type": ["string", "null"] }
        }
      },
      "Note": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "summary"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "summary": { "type": "string" },
          "tag": { "type": ["string", "null"] },
          "amount_gbp": { "type": ["number", "null"] },
          "part_detail": { "type": ["string", "null"] },
          "created_at": { "type": "string" },
          "edited_at": { "type": ["string", "null"] }
        }
      },
      "NoteResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "customer_name", "device_label", "note"],
        "properties": {
          "ref": { "type": "string" },
          "customer_name": { "type": "string" },
          "device_label": { "type": "string" },
          "note": { "$ref": "#/components/schemas/Note" }
        }
      },
      "GetJobResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "customer_name", "device_label", "job", "notes", "photo_count", "photo_captions"],
        "properties": {
          "ref": { "type": "string" },
          "customer_name": { "type": "string" },
          "device_label": { "type": "string" },
          "job": { "$ref": "#/components/schemas/Job" },
          "notes": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } },
          "photo_count": { "type": "integer" },
          "photo_captions": { "type": "array", "items": { "type": ["string", "null"] } }
        }
      },
      "FindHit": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "customer_name", "device_label", "status", "next_move", "summary_line"],
        "properties": {
          "ref": { "type": "string" },
          "customer_name": { "type": "string" },
          "device_label": { "type": "string" },
          "status": { "type": "string" },
          "next_move": { "type": "string" },
          "last_note_summary": { "type": ["string", "null"] },
          "summary_line": { "type": "string", "description": "One line: ref, customer, device, status, next move, last note summary." }
        }
      },
      "FindJobsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filter", "jobs"],
        "properties": {
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "customer_name": { "type": ["string", "null"] },
              "device": { "type": ["string", "null"] },
              "ref": { "type": ["string", "null"] },
              "status": { "type": "string" }
            }
          },
          "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/FindHit" } }
        }
      },
      "CollectionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "customer_name", "device_label", "collection_at", "calendar_event_id", "calendar"],
        "properties": {
          "ref": { "type": "string" },
          "customer_name": { "type": "string" },
          "device_label": { "type": "string" },
          "collection_at": { "type": "string" },
          "calendar_event_id": { "type": "string" },
          "calendar": { "type": "string", "enum": ["created", "updated"] }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "ref": { "type": "string" },
          "customer_name": { "type": "string" },
          "device_label": { "type": "string" }
        }
      }
    }
  }
}
