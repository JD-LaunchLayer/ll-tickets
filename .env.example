# Supabase project URL and the publishable (or legacy anon) key.
# Safe to expose to the browser. Not a secret on its own; row-level security still applies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Older Supabase projects still expose this name. Either key works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by the Action API. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bearer token for the GPT Action API. A long random string. Never commit a real value.
ACTIONS_API_KEY=replace-with-a-long-random-string

# Only this email can receive a sign-in link, and it must match private.owner_allowlist.
OWNER_EMAIL=owner@example.com

# Public https origin of this deployment. Used for the email-link redirect and the
# OpenAPI server URL. Add the same origin to Supabase Auth → URL configuration.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Optional. Requests per minute per instance for the Action API. Default 60.
# ACTIONS_RATE_LIMIT_PER_MINUTE=60

# Google Calendar. Leave unset until you add them. The rest of the Action API works
# without these; create_collection_event then returns calendar_not_configured.
# Share the calendar with the service account email (Make changes to events).
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"","private_key":""}

# Protects /api/cron/purge-photos. Required before the daily photo clean-up will run.
# CRON_SECRET=replace-with-a-long-random-string

# Ask the record, on the phone. Server only. Leave unset and the screen says
# "Assistant is not set up yet." Never commit a real key. The GPT does not use this.
# OPENAI_API_KEY=replace-with-your-openai-key
# Optional. Default is gpt-4.1.
# ASSISTANT_MODEL=gpt-4.1
# Optional. Messages per UTC day. Default 200.
# ASSISTANT_DAILY_MESSAGE_LIMIT=200
